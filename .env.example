# ==========================================
# TransitEye Environment Configuration
# ==========================================

# ------------------------------
# Application
# ------------------------------
NODE_ENV=development

# ------------------------------
# Backend
# ------------------------------
BACKEND_PORT=5000

# ------------------------------
# Frontend
# ------------------------------
FRONTEND_PORT=5173

# ------------------------------
# Supabase
# ------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key-placeholder
SUPABASE_SECRET_KEY=your-secret-key-placeholder

# Legacy key aliases (supported for backward compatibility)
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------
# PostGIS / Spatial Matching
# ------------------------------
# GPS → road segment matching radius in meters (default: 50)
SEGMENT_MATCH_RADIUS_METERS=50

# ------------------------------
# Multi-Bus Consensus
# ------------------------------
# Temporal window in hours for corroborating observations (default: 24)
CONSENSUS_WINDOW_HOURS=24
# Minimum confirming passes/buses to advance status to 'confirmed' (default: 2)
CONSENSUS_MIN_CONFIRMATIONS=2
# Maximum spatial distance in meters to corroborate defects (default: 30)
CONSENSUS_MAX_DISTANCE_METERS=30

# ------------------------------
# Edge Orchestrator
# ------------------------------
EDGE_API_URL=http://localhost:8000
EDGE_BUS_ID=BUS-DEMO-001

# ------------------------------
# AI Feature Flags
# ------------------------------

ENABLE_ROAD_DEFECTS=true
ENABLE_MISSING_INFRA=true
ENABLE_ANPR=true
ENABLE_VEHICLE_DENSITY=true
ENABLE_VRU=true
ENABLE_WATERLOGGING=true

# ------------------------------
# Edge Processing
# ------------------------------

EDGE_NORMAL_CONFIDENCE=0.50
EDGE_ALERT_CONFIDENCE=0.70
EDGE_INCIDENT_CONFIDENCE=0.85

# ------------------------------
# LLM
# ------------------------------

ENABLE_LLM=false
LLM_PROVIDER=
LLM_API_KEY=