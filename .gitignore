# ==========================================
# TransitEye - Git Ignore
# ==========================================

# ------------------------------
# Environment / Secrets
# ------------------------------
.env
.env.local
.env.development
.env.production
.env.*.local

# Keep example environment files
!.env.example


# ------------------------------
# Node.js
# ------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

frontend/dist/
frontend/.vite/

backend/dist/


# ------------------------------
# Python
# ------------------------------
__pycache__/
*.py[cod]
*$py.class

.venv/
venv/
env/
ENV/
ml_venv/

.pytest_cache/
.mypy_cache/
.ruff_cache/

*.egg-info/


# ------------------------------
# Jupyter
# ------------------------------
.ipynb_checkpoints/


# ------------------------------
# AI / ML
# ------------------------------

# Trained model weights
*.pt
*.pth
*.onnx
*.engine
*.weights

# ML experiment outputs
runs/
wandb/
mlruns/

# Model exports
models/*.pt
models/*.pth
models/*.onnx


# ------------------------------
# Datasets
# ------------------------------

data/raw/*
data/processed/*
data/samples/*
ml/anpr/dataset/
ml/anpr/dataset_original_polygon_labels/

# Keep folder structure
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/samples/.gitkeep


# ------------------------------
# Local databases
# ------------------------------

*.db
*.sqlite
*.sqlite3

# Edge local buffer
edge-orchestrator/*.db
edge-orchestrator/*.sqlite


# ------------------------------
# Logs
# ------------------------------

*.log
logs/


# ------------------------------
# OS files
# ------------------------------

.DS_Store
Thumbs.db
desktop.ini


# ------------------------------
# VS Code
# ------------------------------

.vscode/*
!.vscode/extensions.json
!.vscode/settings.json


# ------------------------------
# Temporary files
# ------------------------------

*.tmp
*.temp
*.swp
*.swo