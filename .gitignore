# ==========================================
# TransitEye - Git Ignore
# ==========================================

# ------------------------------
# Environment / Secrets
# ------------------------------
.env
.env.local
.env.development
.env.production
.env.*.local

# Keep example environment files
!.env.example


# ------------------------------
# Node.js
# ------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

frontend/dist/
frontend/.vite/

backend/dist/


# ------------------------------
# Python
# ------------------------------
__pycache__/
*.py[cod]
*$py.class

.venv/
venv/
env/
ENV/

.pytest_cache/
.mypy_cache/
.ruff_cache/

*.egg-info/


# ------------------------------
# Jupyter
# ------------------------------
.ipynb_checkpoints/


# ------------------------------
# AI / ML
# ------------------------------

# Trained model weights
*.pt
*.pth
*.onnx
*.engine
*.weights

# ML experiment outputs
runs/
wandb/
mlruns/

# Model exports
models/*.pt
models/*.pth
models/*.onnx

# ------------------------------
# VRU-3 Training Artifacts
# ------------------------------

# BDD100K dataset (~120K images + converted YOLO labels)
# Do NOT commit the dataset. Re-run bdd100k_to_yolo.py to regenerate labels.
ml/vru/datasets/

# Training run outputs (weights, metrics plots, val predictions)
# best.pt and last.pt are ignored by the *.pt rule above.
# The entire runs tree is excluded to prevent large files being committed.
ml/vru/runs/

# Sanity check output images (large, generated by sanity_check.py)
# Keep the script, not the output images.
!ml/vru/runs/.gitkeep


# ------------------------------
# Datasets
# ------------------------------

data/raw/*
data/processed/*
data/samples/*

# Keep folder structure
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/samples/.gitkeep


# ------------------------------
# Local databases
# ------------------------------

*.db
*.sqlite
*.sqlite3

# Edge local buffer
edge-orchestrator/*.db
edge-orchestrator/*.sqlite


# ------------------------------
# Logs
# ------------------------------

*.log
logs/


# ------------------------------
# OS files
# ------------------------------

.DS_Store
Thumbs.db
desktop.ini


# ------------------------------
# VS Code
# ------------------------------

.vscode/*
!.vscode/extensions.json
!.vscode/settings.json


# ------------------------------
# Temporary files
# ------------------------------

*.tmp
*.temp
*.swp
*.swo


# ------------------------------
# Agent configuration (may contain secrets / local MCP credentials)
# ------------------------------
.agents/


# ------------------------------
# Scratch / local-only one-off scripts
# ------------------------------
scratch/