{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://transiteye.city/schemas/common.schema.json",
  "title": "TransitEye Common Definitions",
  "description": "Shared primitive definitions across TransitEye data contracts",
  "definitions": {
    "location": {
      "type": "object",
      "description": "Geographic location with optional telemetry attributes",
      "required": ["latitude", "longitude"],
      "properties": {
        "latitude": {
          "type": "number",
          "minimum": -90.0,
          "maximum": 90.0,
          "description": "WGS84 latitude coordinate"
        },
        "longitude": {
          "type": "number",
          "minimum": -180.0,
          "maximum": 180.0,
          "description": "WGS84 longitude coordinate"
        },
        "altitude": {
          "type": ["number", "null"],
          "description": "Altitude in meters above sea level"
        },
        "speed": {
          "type": ["number", "null"],
          "minimum": 0.0,
          "description": "Bus speed in km/h at time of observation"
        },
        "heading": {
          "type": ["number", "null"],
          "minimum": 0.0,
          "maximum": 360.0,
          "description": "Compass heading in degrees (0-360)"
        },
        "accuracy": {
          "type": ["number", "null"],
          "minimum": 0.0,
          "description": "GPS horizontal accuracy in meters"
        }
      },
      "additionalProperties": false
    },
    "severity": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"],
      "description": "Normalized severity level of the event or defect"
    },
    "status": {
      "type": "string",
      "enum": ["pending", "confirmed", "in_review", "resolved", "rejected"],
      "description": "Lifecycle status of the observation"
    },
    "bus_id": {
      "type": "string",
      "minLength": 1,
      "description": "Identifier of the sensing transit bus (e.g. BUS-DEL-001)"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 UTC timestamp of occurrence"
    }
  }
}
